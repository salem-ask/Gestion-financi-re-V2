# Variables d'environnement necessaires a la synchronisation cloud (Supabase).
#
# Copier ce fichier en .env (deja ignore par git, voir .gitignore) et
# renseigner les valeurs reelles depuis le tableau de bord Supabase du
# projet (Project Settings > API).
#
# Tant que ces variables ne sont pas definies, l'application continue de
# fonctionner normalement en local uniquement (IndexedDB) : aucune partie
# du code actuel ne les lit encore (voir services/sync, phases suivantes).

# URL du projet Supabase, ex: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Cle publique "anon" du projet Supabase (jamais la cle "service_role",
# qui ne doit jamais etre exposee cote client).
VITE_SUPABASE_ANON_KEY=
